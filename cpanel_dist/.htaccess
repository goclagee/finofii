Options -MultiViews
RewriteEngine On
RewriteBase /

# Serve static files directly
RewriteRule \.(png|jpg|jpeg|gif|svg|webp|avif|ico|css|js|map|woff|woff2|ttf|eot|json|txt|pdf)$ - [L,NC]

# Bypass URL rewrite for the /api folder
RewriteRule ^api/ - [L,NC]

# Bypass for amc-logos folder
RewriteRule ^amc-logos/ - [L,NC]

# Bypass for static folder
RewriteRule ^static/ - [L,NC]

# Route all other non-file/non-folder requests to index.html for React Router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Add MIME types
AddType image/webp .webp
AddType image/avif .avif
AddType image/svg+xml .svg
